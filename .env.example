# Copy this file to .env, edit the paths/endpoints for your machine, then run:
# set -a
# source .env
# set +a

# Data and local caches.
ASO_DATA_ROOT="${PWD}/data"
HF_HOME="${PWD}/.cache/huggingface"
TRANSFORMERS_CACHE="${HF_HOME}/transformers"
HF_HUB_ENABLE_HF_TRANSFER=0

# ASO training.
CONFIG_NAME="complex_logprob_flux_kontext_mmsafetybench_qr_qwen3_vl_dynamic"
TRAIN_CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6
ASO_NUM_TRAIN_GPUS=7
ASO_TARGET_SAMPLES_PER_EPOCH=48
FLUX_KONTEXT_MODEL="black-forest-labs/FLUX.1-Kontext-dev"
VICTIM_MODEL="qwen3-vl-8b"
WANDB_MODE=offline
MAIN_PROCESS_PORT=29501
# ASO_SMOKE_DATASET="${ASO_DATA_ROOT}/MM-SafetyBench/MM-SafetyBench_imgs_clean/mmsafetybench_sd_typo_smoke.json"

# Victim VLM service. For local reproduction, choose an idle GPU and start it with:
# bash scripts/run_qwen3vl_vllm.sh
VICTIM_CUDA_VISIBLE_DEVICES=0
VICTIM_MODEL_PATH="Qwen/Qwen3-VL-8B-Instruct"
VICTIM_SERVED_MODEL_NAME="qwen3-vl-8b"
VICTIM_HOST="0.0.0.0"
VICTIM_PORT=8021
VICTIM_API_BASE_URL="http://127.0.0.1:8021/v1"
VICTIM_API_KEY="EMPTY"
VICTIM_DTYPE=bfloat16
VICTIM_MAX_MODEL_LEN=32768
VICTIM_GPU_MEMORY_UTILIZATION=0.90

# HarmBench judge service. For local reproduction, choose an idle GPU and start it with:
# bash scripts/run_harmbench_server.sh
HARM_BENCH_CUDA_VISIBLE_DEVICES=7
HARM_BENCH_HOST="0.0.0.0"
HARM_BENCH_PORT=5000
HARM_BENCH_API_URL="http://127.0.0.1:5000"
HARM_BENCH_MODEL="cais/HarmBench-Llama-2-13b-cls"
HARM_BENCH_CONCURRENCY=1
HARM_BENCH_LOG_LEVEL=info

# Optional external API keys. Leave these as-is for a local/vLLM victim.
OPENAI_API_KEY="EMPTY"
GOOGLE_API_KEY=

# Final evaluation only. Uncomment and edit these after training finishes.
# SAVE_DIR="logs/complex_logprob/mmsafetybench_sd_typo_qwen3-vl-8b_transfer_the_style_to_low_poly_dynamic"
# BASELINE_MANIFEST="${ASO_DATA_ROOT}/MM-SafetyBench/MM-SafetyBench_imgs_clean/mmsafetybench_sd_typo.json"
# VICTIM_ENV_ACTIVATE="/path/to/vllm-env/bin/activate"
# START_EXTRA_QWEN=0
# NUM_SHARDS=1
# QWEN_PORTS=8021
# EXTRA_QWEN_GPUS=0,1,2,3,4,5,6
# EXTRA_QWEN_PORTS=8022,8023,8024,8025,8026,8027,8028
# AUTO_STOP_EXTRA_QWEN=1
